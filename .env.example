# Copia este archivo como .env para desarrollo local. Nunca versiones el .env real.
# En el servidor, las variables vienen de /etc/sicop-connect/app.env.
APP_ENV=development
APP_TIMEZONE=America/Costa_Rica
DATABASE_PATH=data/sicop.db
RAW_DATA_DIR=data/raw
INCOMING_DIR=data/incoming
SOURCE_MODE=manual
AI_MODE=none
# Envío real (notify --send) solo con NOTIFICATIONS_ENABLED=true, NOTIFICATIONS_DRY_RUN=false y
# MAIL_PROVIDER=gmail_api. Mientras no se autorice, se deja así.
NOTIFICATIONS_ENABLED=false
NOTIFICATIONS_DRY_RUN=true
SCHEDULER_ENABLED=false
MAIL_PROVIDER=unconfigured
# Cuenta que envía los avisos (con gmail_api: la que autoriza en python -m app.cli google-auth).
MAIL_FROM=
# Gmail (ver docs/GOOGLE_API.md). Rutas FUERA del proyecto; nunca en git ni pegadas en un chat.
# GOOGLE_CLIENT_FILE: el JSON del cliente OAuth que entrega el administrador.
# GOOGLE_TOKEN_FILE: donde google-auth guarda el permiso (se crea solo).
GOOGLE_CLIENT_FILE=
GOOGLE_TOKEN_FILE=
# Obtención automática (lección 1): leer en el buzón los correos de SICOP con permiso de SOLO LECTURA.
# SICOP_REQUEST_EMAIL: el buzón donde llegan los correos de SICOP (el que autoriza en obtain gmail-auth).
# GOOGLE_READ_TOKEN_FILE: donde obtain gmail-auth guarda ese permiso. Otro archivo que GOOGLE_TOKEN_FILE,
# también fuera del proyecto. Usa el mismo GOOGLE_CLIENT_FILE.
SICOP_REQUEST_EMAIL=
GOOGLE_READ_TOKEN_FILE=
# Lección 2 (obtain request): minutos que se espera el correo con el código de SICOP (1 a 60).
OBTAIN_CODE_TIMEOUT_MIN=10
# Lección 3 (obtain poll): horas máximas de espera del correo con el enlace (1 a 23) y cada cuántos minutos
# obtain poll --seguir revisa el buzón (1 a 60). El enlace suele llegar 2 a 6 min después del código.
OBTAIN_LINK_MAX_HOURS=12
OBTAIN_POLL_MINUTES=5
# Lección 4 (obtain auto, la tarea programada cada 15 min): con SOURCE_MODE=auto pide el reporte en cada hora de
# OBTAIN_REQUEST_HOUR (HH:MM; una o dos separadas por coma: una solicitud por turno) y revisa el buzón.
# En el servidor (2026-10-26): 06:30,14:00. La vuelta no manda avisos: salen a las 8:00 con el ciclo.
# OBTAIN_DOWNLOAD: manual (por defecto; SICOP bloqueó la descarga hecha por el programa): al llegar el enlace se manda
# el recordatorio de descargar el ZIP y subirlo en el panel · auto: la app lo descarga.
# OBTAIN_ALERT_TO: buzón que recibe el recordatorio y la alerta si la obtención falla. Sin valor: solo vista previa.
OBTAIN_REQUEST_HOUR=07:00
OBTAIN_DOWNLOAD=manual
OBTAIN_ALERT_TO=
# Enriquecimiento de carteles (lección 2, python -m app.cli enrich --nro N): ficha de la consulta pública de SICOP.
# BROWSER_HEADLESS=false: el navegador se abre CON ventana, para que se vea qué consulta (no cambiarlo sin acuerdo).
# RECORDINGS_DIR: video y capturas de cada consulta, fuera de Git. ENRICH_DELAY_SECONDS: pausa entre consultas.
BROWSER_HEADLESS=false
RECORDINGS_DIR=data/grabaciones
ENRICH_DELAY_SECONDS=8
# Documentos de la ficha (lección 3, enrich --documentos): carpeta fuera de Git (entra en el respaldo), tamaño
# máximo de un documento y tope por cartel, en MB.
DOCUMENTS_DIR=data/documentos
DOCUMENT_MAX_MB=50
DOCUMENTS_MAX_MB_PER_TENDER=100
# Gestor de documentos, paso 2: archivos subidos a los expedientes (pliego, borradores). Fuera de Git; entran en
# el respaldo. Tamaño máximo de UN archivo, en MB (10 por ahora, decisión de Oscar del 2026-10-26).
EXPEDIENTES_DIR=data/expedientes
EXPEDIENTE_MAX_MB=10
# Enriquecimiento automático (lección 4, enrich run: tarea programada de las 10:00, lunes a viernes, CON ventana).
# ENRICH_ENABLED=false: enrich run no consulta SICOP (se activa a mano). ENRICH_MAX_PER_DAY: carteles por día.
# RECORDINGS_KEEP_DAYS: días que se guardan los videos (los de un FALLO se conservan). La alerta ante CAPTCHA y el
# resumen van a OBTAIN_ALERT_TO, con las mismas reglas de envío que los avisos (dry-run: solo vista previa).
ENRICH_ENABLED=false
ENRICH_MAX_PER_DAY=20
RECORDINGS_KEEP_DAYS=30
# Ante un CAPTCHA o bloqueo: espera ENRICH_RETRY_WAIT_MINUTES con el navegador cerrado y reintenta UNA vez (el CAPTCHA
# nunca se resuelve); si vuelve a salir, se detiene y avisa. Al pasar el cierre de un cartel se borran su ficha y sus
# documentos, menos los marcados «Interesa» u «Ofertada» o con seguimiento (DECISION_OBTENCION.md §9).
ENRICH_RETRY_WAIT_MINUTES=15
# Reporte de cartel con IA (lección 1, ia expediente): tamaño máximo del expediente de un cartel, en tokens
# (1 token ≈ 4 caracteres). Lo que no cabe se lista como omitido. La IA sigue apagada con AI_MODE=none.
IA_MAX_INPUT_TOKENS=50000
# Conexión con OpenAI (lección 2). AI_MODE=openai solo cuando Oscar lo active. La clave del proyecto de OpenAI de
# Hermatix la escribe Oscar en el .env real, en persona: nunca en Git, en un chat ni en Claude. El modelo lo
# eligen Oscar e Ivania (docs/DECISION_IA.md). Los precios, en USD por millón de tokens, se copian de la página
# oficial de precios de OpenAI para ese modelo; vacíos, el costo estimado queda «sin precio».
OPENAI_API_KEY=
OPENAI_MODEL=
IA_TIMEOUT_SECONDS=120
IA_MAX_OUTPUT_TOKENS=4000
IA_PRECIO_ENTRADA_USD=
IA_PRECIO_SALIDA_USD=
# Lección 3: versión del prompt del resumen (config/prompts/resumen_cartel_v1.md). Un cambio del prompt se guarda
# como versión nueva (v2, v3…), nunca encima de la anterior.
IA_PROMPT_VERSION=v1
# Quién recibe los avisos se edita en el panel («Destinatarios»). MAIL_TO ya no existe: si sigue en un .env viejo,
# se ignora y se puede borrar.
# Avisos (lección 7): vista previa del dry-run, dirección del panel para los enlaces del correo
# (en el servidor: https://sicop.hermatix.com) y días hacia atrás que cuenta el primer lote.
EXPORTS_DIR=data/exports
APP_BASE_URL=http://127.0.0.1:8000
NOTIFY_LOOKBACK_DAYS=7
# Aviso de cierre próximo (A4): una oportunidad marcada «Interesa» o «Revisar requisitos» sin decisión final
# («Ofertada» o «No se oferta») que cierra en estos días o menos.
NOTIFY_CLOSING_DAYS=3
# Secreto que firma la cookie de sesión: largo y aleatorio, por ejemplo
# python -c "import secrets; print(secrets.token_urlsafe(48))". Obligatorio fuera de development.
SESSION_SECRET=
# Duración de la sesión en horas.
SESSION_MAX_AGE_HOURS=8
# Tamaño máximo de un archivo subido desde el panel, en MB (los reportes reales pesan 3–5 MB).
UPLOAD_MAX_MB=25
